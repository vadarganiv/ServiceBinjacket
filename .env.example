# PostgreSQL
POSTGRES_DB=servis_binjaket
POSTGRES_USER=servis_user
POSTGRES_PASSWORD=change_me

# Full connection string used by ASP.NET Core
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=servis_binjaket;Username=servis_user;Password=change_me

# Authentication (development placeholders; Production rejects them)
JWT_SECRET=change_me_long_random_secret_at_least_32_bytes
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change_me

# URLs
# Public canonical URL. Use HTTPS in Production.
PUBLIC_SITE_URL=http://localhost:3000

# Internal URL used by the frontend container to reach the backend.
API_URL=http://backend:5000

# Comma-separated browser origins allowed by the API.
CORS_ORIGINS=http://localhost:3000

# Domain (required only when HTTPS/Certbot is enabled)
# DOMAIN=your-domain.com
# CERTBOT_EMAIL=your@email.com

# Uploads
UPLOADS_ROOT=/app/uploads
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=4
MAX_UPLOAD_TOTAL_MB=30

# Public business details. Replace examples before deployment.
PUBLIC_ADDRESS=Durrës, Rruga ..., Nr. ...
PUBLIC_PHONE=+355 69 XX XX XXX
PUBLIC_HOURS=E hënë–E shtunë 09:00–18:00; E dielë: pushim
# International digits used for wa.me links.
WHATSAPP_PHONE=355000000000

# Backups (used by scripts/backup-db.sh)
# BACKUP_DIR=/backups
