# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=servis_binjaket
POSTGRES_USER=servis_user
POSTGRES_PASSWORD=change_me

# Full connection string used by ASP.NET Core
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=servis_binjaket;Username=servis_user;Password=change_me

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_long_random_secret_at_least_32_bytes
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change_me

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public URL (shown in links, emails, etc.)
# HTTP mode (no domain): http://<VPS_IP>
# HTTPS mode (with domain): https://your-domain.com
PUBLIC_SITE_URL=http://your-vps-ip

# Used by frontend container to reach backend (internal docker network — do not change)
API_URL=http://backend:5000

# CORS allowed origins (comma-separated). In same-origin prod (nginx) — оставить дефолт.
# Если фронт раздаётся с отдельного origin (например http://VPS_IP), добавить его сюда.
CORS_ORIGINS=http://localhost:3000

# ── Domain (HTTPS — заполнить когда купите домен) ─────────────────────────────
# DOMAIN=your-domain.com
# CERTBOT_EMAIL=your@email.com

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOADS_ROOT=/app/uploads
MAX_UPLOAD_MB=25

# ── Business ──────────────────────────────────────────────────────────────────
# Адрес магазина — как должно отображаться на сайте (Footer, Contact page)
PUBLIC_ADDRESS=Durrës, Rruga ..., Nr. ...
# Телефон — формат произвольный, отображается как есть (фронт убирает пробелы для tel: ссылок)
PUBLIC_PHONE=+355 69 XX XX XXX
# Часы работы — формат свободный, отображается как есть
PUBLIC_HOURS=E hënë–E shtunë 09:00–18:00; E dielë: pushim
# WhatsApp — международный формат без пробелов и без +, для wa.me/<num>
WHATSAPP_PHONE=+355000000000
DEFAULT_CURRENCY=ALL
DEFAULT_LOCALE=sq
SUPPORTED_LOCALES=sq,en

# ── Backups (только для scripts/backup-db.sh) ─────────────────────────────────
# BACKUP_DIR=/backups
